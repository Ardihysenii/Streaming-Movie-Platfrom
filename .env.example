# Free Fanart.tv title-logo key (optional)
NEXT_PUBLIC_FANART_CLIENT_KEY=your_fanart_personal_key

# Free TMDB v3 developer key for catalog metadata. Do not place the longer
# API Read Access Token in a NEXT_PUBLIC variable.
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_v3_api_key

# Server/edge-only SubDL key (never expose as NEXT_PUBLIC_SUBDL_API_KEY)
SUBDL_API_KEY=your_subdl_api_key

# Optional direct-stream architecture (not required by the active iframe embed)
NEXT_PUBLIC_NOVA_STREAM_API_URL=https://nova-stream-resolver.your-account.workers.dev

# Active iframe provider used by the legacy URL builder (the watch page uses
# CustomMoviePlayer and NEXT_PUBLIC_VIDEO_PROVIDER_URL directly).
NEXT_PUBLIC_PLAYER_PROVIDER=cinesrc
NEXT_PUBLIC_VIDLINK_URL=https://vidlink.pro
NEXT_PUBLIC_VIDCORE_URL=https://vidcore.net
NEXT_PUBLIC_VIDCORE_SERVER=Premiere
NEXT_PUBLIC_VIDEO_PROVIDER_URL=https://cinesrc.st
# Set to https://vidsrc.sbs to restore the previous VidSrc embed flow.
NEXT_PUBLIC_YAPGRID_URL=https://yapgrid.com
NEXT_PUBLIC_MAPPLE_URL=https://mapple.rip
